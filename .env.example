# Firebase Auth (Google sign-in)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Supabase (data layer)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ticketmaster Discovery API (show ingestion script, not used by the app itself)
TICKETMASTER_API_KEY=

# Same Ticketmaster key, client-exposed for in-app artist typeahead —
# Discovery API keys are meant for public/client-side use.
VITE_TICKETMASTER_API_KEY=

# Jambase v3 API (show ingestion script, not used by the app itself)
JAMBASE_API_KEY=
